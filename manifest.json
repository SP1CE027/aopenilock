{
  "manifest_version": 3,
  "name": "ChatGPT Privacy Lock",
  "version": "1.1.0",
  "description": "PIN-locks the entire chatgpt.com origin on every page load.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ]
}